---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import config from "@/config";

const description =
  "Ask questions about Othón González's background in agentic AI, computer vision, and applied research.";
---

<Layout title={`CV | ${config.site.title}`} description={description}>
  <Header />
  <Breadcrumb />
  <Main pageTitle="Ask about my work." class="pb-8">
    <section aria-labelledby="cv-intro" class="mb-8">
      <p id="cv-intro" class="text-muted-foreground max-w-2xl leading-7">
        I’m Othón González. Explore my background in agentic AI, computer
        vision, and applied research through a conversation grounded in my CV.
        Ask in English or español.
      </p>
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Areas of experience">
        {
          [
            "Agentic AI",
            "Computer vision",
            "Applied research",
            "Data engineering",
          ].map(area => (
            <li class="border-border bg-muted/30 rounded-full border px-3 py-1 text-sm">
              {area}
            </li>
          ))
        }
      </ul>
    </section>

    <section
      data-cv-chat
      aria-label="CV conversation"
      class="border-border overflow-hidden rounded-2xl border shadow-sm"
    >
      <div
        class="border-border bg-muted/30 flex flex-wrap items-center justify-between gap-3 border-b px-4 py-3"
      >
        <h2 class="font-semibold">Start a conversation</h2>
        <span class="text-muted-foreground text-xs"
          >A few ideas to get started ↓</span
        >
      </div>

      <div class="bg-background px-4 pt-4 pb-3 sm:px-5">
        <div class="flex flex-wrap gap-2" aria-label="Example questions">
          <button
            data-cv-example
            data-question="What did you build at Teradata?"
            type="button"
            class="border-border bg-muted/20 hover:border-accent rounded-full border px-3 py-2 text-start text-sm transition-colors"
            >What did you build at Teradata?</button
          >
          <button
            data-cv-example
            data-question="Tell me about your computer vision work."
            type="button"
            class="border-border bg-muted/20 hover:border-accent rounded-full border px-3 py-2 text-start text-sm transition-colors"
            >Tell me about your computer vision work.</button
          >
          <button
            data-cv-example
            data-question="¿Qué experiencia tienes con agentes de IA?"
            type="button"
            class="border-border bg-muted/20 hover:border-accent rounded-full border px-3 py-2 text-start text-sm transition-colors"
            >¿Qué experiencia tienes con agentes de IA?</button
          >
        </div>
      </div>

      <div
        data-cv-transcript
        role="log"
        aria-live="polite"
        aria-relevant="additions"
        aria-label="Conversation"
        class="bg-background min-h-48 space-y-5 px-4 py-4 sm:min-h-64 sm:px-5"
      >
      </div>
      <p
        data-cv-status
        role="status"
        aria-live="polite"
        class="text-muted-foreground min-h-6 px-4 text-sm sm:px-5"
      >
      </p>

      <div class="border-border bg-muted/20 border-t p-3 sm:p-4">
        <form
          data-cv-form
          class="border-border focus-within:border-accent bg-background flex items-end gap-2 rounded-xl border p-2 transition-colors"
        >
          <label class="sr-only" for="cv-question"
            >Ask about experience, projects, or research</label
          >
          <textarea
            data-cv-input
            id="cv-question"
            name="question"
            rows="2"
            maxlength="1000"
            required
            placeholder="Ask about experience, projects, research…"
            class="text-foreground placeholder:text-muted-foreground max-h-40 min-h-12 flex-1 resize-y bg-transparent px-2 py-2 text-sm outline-none"
          ></textarea>
          <button
            data-cv-submit
            type="submit"
            class="bg-accent text-accent-foreground focus-outline rounded-lg px-4 py-2.5 text-sm font-semibold hover:opacity-90 disabled:cursor-wait disabled:opacity-60"
          >
            Send <span aria-hidden="true">↗</span>
          </button>
        </form>
        <div
          class="text-muted-foreground flex flex-wrap justify-between gap-1 px-1 pt-2 text-xs"
        >
          <span
            >English or español · Enter to send · Shift+Enter for a new line</span
          >
          <span>Answers are grounded in CV material</span>
        </div>
        <div data-cv-turnstile class="mt-2 flex justify-end"></div>
      </div>
    </section>

    <aside
      data-cv-disclosure
      class="text-muted-foreground mt-4 flex flex-col gap-3 text-sm leading-6 sm:flex-row sm:items-start sm:justify-between"
    >
      <p class="max-w-xl">
        This AI-generated assistant can make mistakes. Questions are sent to an
        AI service to generate answers; conversation history stays in this page
        only while it is open. For a direct conversation, connect with me on
        LinkedIn.
      </p>
      <div class="shrink-0" aria-label="Contact and social links">
        <Socials />
      </div>
    </aside>
  </Main>
  <Footer />
</Layout>

<script>
  import { initCvChat } from "@/scripts/cv-chat";

  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLElement>("[data-cv-chat]")
      .forEach(initCvChat);
  });
</script>

<style>
  :global(.cv-message) {
    max-width: 88%;
  }

  :global(.cv-message-user) {
    margin-inline-start: auto;
    border-radius: 1rem 1rem 0.25rem 1rem;
    background: var(--accent);
    color: var(--accent-foreground);
    padding: 0.75rem 1rem;
  }

  :global(.cv-message-assistant) {
    border: 1px solid var(--border);
    border-radius: 1rem 1rem 1rem 0.25rem;
    background: color-mix(in srgb, var(--muted) 22%, var(--background));
    padding: 0.75rem 1rem;
  }

  :global(.cv-message-label) {
    margin-bottom: 0.35rem;
    color: var(--muted-foreground);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.cv-message-body) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  :global(.cv-source-list) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }

  :global(.cv-source-list li) {
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    padding: 0.15rem 0.4rem;
    color: var(--muted-foreground);
    font-size: 0.7rem;
  }

  @media (max-width: 640px) {
    :global(.cv-message) {
      max-width: 96%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-cv-chat] *) {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
