---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section>
        <h1>Uthynauta</h1>
        <p>Notes on AI systems, agents, and whatever comes next.</p>

        <p>
          Technical essays, experiments, and notes about LLMs,
          inference, observability, agentic systems, and engineering.
        </p>

        <p>
          <a href="/blog/">Read the articles →</a>
        </p>
      </section>
    </main>
    <Footer />
  </body>
</html>