{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-blog",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-06",
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "ratelimits": [
    {
      "name": "CV_CHAT_RATE_LIMITER",
      "namespace_id": "2026093001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
}
